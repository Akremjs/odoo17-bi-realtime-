<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bi_todo_view_list" model="ir.ui.view">
        <field name="name">bi.todo.list</field>
        <field name="model">bi.todo</field>
        <field name="arch" type="xml">
            <tree string="Tâches" default_order="sequence">
                <field name="sequence" widget="handle"/>
                <field name="is_done" widget="boolean_toggle"/>
                <field name="name" decoration-danger="is_overdue" decoration-success="is_done"/>
                <field name="priority"/>
                <field name="user_id"/>
                <field name="deadline"/>
                <field name="dashboard_id"/>
                <field name="tag"/>
                <field name="is_overdue" column_invisible="1"/>
            </tree>
        </field>
    </record>
    <record id="bi_todo_view_form" model="ir.ui.view">
        <field name="name">bi.todo.form</field>
        <field name="model">bi.todo</field>
        <field name="arch" type="xml">
            <form string="Tâche">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="priority" widget="radio"/>
                            <field name="is_done"/>
                            <field name="tag"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="deadline"/>
                            <field name="dashboard_id"/>
                            <field name="color" widget="color"/>
                        </group>
                    </group>
                    <field name="description"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_bi_todo" model="ir.actions.act_window">
        <field name="name">Tâches</field>
        <field name="res_model">bi.todo</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>




