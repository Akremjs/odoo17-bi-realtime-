<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_bi_ai_proactive_list" model="ir.ui.view">
    <field name="name">bi.ai.proactive.list</field>
    <field name="model">bi.ai.proactive</field>
    <field name="arch" type="xml">
      <tree string="Alertes IA Proactives"
            decoration-danger="severity == 'danger'"
            decoration-warning="severity == 'warning'"
            decoration-muted="is_read == True">
        <field name="create_date" string="Date"/>
        <field name="name" string="Alerte"/>
        <field name="severity" widget="badge"
               decoration-danger="severity == 'danger'"
               decoration-warning="severity == 'warning'"
               decoration-info="severity == 'info'"/>
        <field name="is_read" string="Lu" widget="boolean_toggle"/>
        <field name="notified" string="Notifié" readonly="1"/>
        <button name="action_mark_read" type="object"
                string="Marquer lu" icon="fa-check"
                invisible="is_read == True"/>
      </tree>
    </field>
  </record>

  <record id="view_bi_ai_proactive_form" model="ir.ui.view">
    <field name="name">bi.ai.proactive.form</field>
    <field name="model">bi.ai.proactive</field>
    <field name="arch" type="xml">
      <form string="Alerte IA Proactive">
        <header>
          <button name="action_mark_read" type="object"
                  string="✅ Marquer comme lu"
                  class="btn-primary"
                  invisible="is_read == True"/>
        </header>
        <sheet>
          <div class="oe_title">
            <h1><field name="name"/></h1>
          </div>
          <group>
            <field name="severity" widget="badge"/>
            <field name="create_date" string="Générée le" readonly="1"/>
            <field name="is_read" readonly="1"/>
            <field name="notified" readonly="1"/>
          </group>
          <separator string="🤖 Analyse IA"/>
          <field name="analysis" nolabel="1" readonly="1"
                 widget="text"
                 style="font-size:13px;line-height:1.8;
                        background:#f5f3ff;padding:16px;
                        border-radius:8px;border-left:4px solid #4f46e5"/>
          <separator string="📊 Données KPIs"/>
          <field name="kpi_data" nolabel="1" readonly="1" widget="text"/>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_bi_ai_proactive" model="ir.actions.act_window">
    <field name="name">🤖 Alertes IA Proactives</field>
    <field name="res_model">bi.ai.proactive</field>
    <field name="view_mode">tree,form</field>
    <field name="domain">[('is_read','=',False)]</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        Aucune alerte proactive pour le moment !
      </p>
      <p>L'IA surveille automatiquement vos KPIs et génère des alertes intelligentes.</p>
    </field>
  </record>

  <!-- Cron job -->
  <record id="ir_cron_bi_ai_proactive" model="ir.cron">
    <field name="name">BI — Analyse IA Proactive</field>
    <field name="model_id" ref="bi_realtime.model_bi_ai_proactive"/>
    <field name="state">code</field>
    <field name="code">model._run_proactive_analysis()</field>
    <field name="interval_number">30</field>
    <field name="interval_type">minutes</field>
    <field name="numbercall">-1</field>
    <field name="active">True</field>
  </record>

</odoo>
