<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bi_import_dashboard_wizard_view" model="ir.ui.view">
        <field name="name">bi.import.dashboard.wizard.form</field>
        <field name="model">bi.import.dashboard.wizard</field>
        <field name="arch" type="xml">
            <form string="Importer un dashboard">
                <group>
                    <field name="file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                    <field name="preview" readonly="1"/>
                </group>
                <footer>
                    <button name="action_import" string="Importer" type="object" class="btn-primary"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_import_dashboard" model="ir.actions.act_window">
        <field name="name">Importer un dashboard</field>
        <field name="res_model">bi.import.dashboard.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>




