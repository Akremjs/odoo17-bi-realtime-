<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

  <!-- Cron: Rafraîchissement automatique de tous les KPIs Odoo (toutes les 5 min) -->
  <record id="ir_cron_bi_kpi_refresh" model="ir.cron">
    <field name="name">BI — Rafraîchir KPIs Odoo</field>
    <field name="model_id" ref="bi_realtime.model_bi_kpi"/>
    <field name="state">code</field>
    <field name="code">model._cron_refresh_all_odoo_kpis()</field>
    <field name="interval_number">5</field>
    <field name="interval_type">minutes</field>
    <field name="numbercall">-1</field>
    <field name="active">True</field>
    <field name="priority">100</field>
  </record>

</odoo>
